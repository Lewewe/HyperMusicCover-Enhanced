    <string name="credits_lewewe">Maintains the Enhanced fork for HyperOS 4, improving artwork, lyrics, status icons, notification gestures, AOD, and player customization.</string>
    <string name="credits_puhboo">Contributed online lyric translation with LibreTranslate, Google Cloud and DeepL, Extended lyric search with title and artist aliases, Spicy Lyrics support and provider caching. Also contributed parsing and word-timing improvements, native translation and romanization integration, and optional Alive lyrics effects, including the Eye-Candy pause fix.</string>
    <string name="credits_hypernavbar">The app\'s UI foundation: theme, floating and liquid glass navigation bars, background blur, the About page and language switching</string>
    <string name="credits_miuix">The UI component library used throughout the app</string>
    <string name="credits_liquid_glass">Lens, inner shadow and vibrancy effects for liquid glass</string>
    <string name="credits_markdown_css">Release notes styling</string>
    <string name="credits_cialloum">The square cover card, the thumbnail-to-cover morph, and the lock screen lyric position, size and weight settings</string>
    <string name="credits_hyperchanger">The lock screen Super Island (ported by btm_m), and removing the depth effect, saved lock screen, clock colon and global theme glass restrictions</string>
    <string name="credits_leaf">Video and depth video wallpaper support</string>
    <string name="credits_hypertweak">Hiding the lock screen fingerprint icon and its animation</string>
    <string name="credits_amll">Lock screen lyric animation</string>
    <string name="credits_amll_db">Word-by-word lyrics database</string>
    <string name="credits_accompanist">TTML, LRC, YRC and KRC lyric parsing</string>
    <string name="credits_lyricinfo">A source of lyrics from music apps</string>
    <string name="credits_hle">QQ Music, Kuwo and TTML Hub lyrics, and the song matching rules</string>
    <string name="credits_lsposed">The hook framework this module runs on</string>
    <string name="credits_installerx">Installing updates through an installer app, hiding the launcher icon, and the dial code</string>
